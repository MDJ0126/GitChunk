<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <WindowsBuild>$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))</WindowsBuild>
    <WindowsBuild Condition="'$(Headless)' == 'true'">False</WindowsBuild>
    <OutputType Condition="'$(WindowsBuild)' == 'True'">WinExe</OutputType>
    <OutputType Condition="'$(WindowsBuild)' != 'True'">Exe</OutputType>
    <TargetFramework Condition="'$(WindowsBuild)' == 'True'">net9.0-windows</TargetFramework>
    <TargetFramework Condition="'$(WindowsBuild)' != 'True'">net9.0</TargetFramework>
    <UseWPF Condition="'$(WindowsBuild)' == 'True'">true</UseWPF>
    <ApplicationIcon Condition="'$(WindowsBuild)' == 'True'">Assets/AppIcon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GitChunk</AssemblyName>
    <Version>1.2.3</Version>
    <Product>Git Chunk</Product>
    <Description>Git-native chunk storage for large files</Description>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(WindowsBuild)' == 'True'">
    <Resource Include="Assets/AppIcon.png"/>
    <Resource Include="Assets/AppIcon.ico"/>
  </ItemGroup>
  <ItemGroup><Compile Remove="Tests/**/*.cs" /></ItemGroup>
  <ItemGroup Condition="'$(WindowsBuild)' != 'True'">
    <Compile Remove="MainWindow.xaml.cs"/>
    <Page Remove="MainWindow.xaml"/>
    <None Remove="MainWindow.xaml"/>
  </ItemGroup>
</Project>
