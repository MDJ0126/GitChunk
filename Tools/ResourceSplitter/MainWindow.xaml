<Window x:Class="MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Git Chunk" Icon="Assets/AppIcon.ico"
 Width="900" Height="880" MinWidth="780" MinHeight="810" WindowStartupLocation="CenterScreen"
 Background="#F5F7FA" FontFamily="Segoe UI" FontSize="13" Foreground="#172238"
 AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DFEA"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#D7DFEA"/></Style>
 </Window.Resources>
 <Border Padding="32,24" Background="#F5F7FA"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="155"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22">
   <Image Source="Assets/AppIcon.png" Width="54" Height="54" Margin="0,0,14,0"/>
   <StackPanel><TextBlock Text="Git Chunk" FontFamily="Segoe UI" FontSize="29" FontWeight="Bold"/><TextBlock Text="Install once. Use Git as usual." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E0E6EF" BorderThickness="1" Padding="20" Margin="0,0,0,16">
   <StackPanel>
    <TextBlock Text="Git repository" FontWeight="Bold" Margin="0,0,0,10"/>
    <DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse" Click="Browse" Margin="10,0,0,0"/><TextBox x:Name="FolderPath" ToolTip="Select or drop the repository root folder."/></DockPanel>
    <TextBlock x:Name="ModeHint" Text="Checking installation…" TextWrapping="Wrap" Foreground="#466484" Margin="0,12,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E0E6EF" BorderThickness="1" Padding="20">
   <Grid x:Name="Modes">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Chunk rules" FontWeight="Bold"/>
    <TextBlock Grid.Row="1" Text="One pattern per line · * and ** supported · ! excludes · last match wins" Foreground="#64748B" FontSize="11" Margin="0,7,0,10"/>
    <TextBox x:Name="RulesEditor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" MinHeight="100" TextChanged="RulesChanged"/>
    <Button Grid.Row="3" Content="Save rules" Click="SaveRules" HorizontalAlignment="Right" Margin="0,12,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="3" Margin="0,16,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="Files over 50 MiB → 49 MiB chunks · local originals preserved" TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,5,0,0"/><ProgressBar x:Name="Progress" Height="3" Width="180" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,7,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
    <Button Content="Update to latest" Click="UpdateLatest" IsEnabled="{Binding IsEnabled, ElementName=RunButton}" Margin="0,0,8,0"/>
    <Button x:Name="RunButton" Content="Install Git Chunk  →" Click="Execute" Background="#2864EB" Foreground="White" BorderBrush="#2864EB" Padding="16,12" Margin="0" FontWeight="Bold"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="4" Background="White" CornerRadius="12" BorderBrush="#E0E6EF" BorderThickness="1" Padding="16,12">
   <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Copy log" Click="CopyLog" FontSize="11" Padding="8,3" Margin="0"/><TextBlock Text="Activity log" FontWeight="Bold"/></DockPanel><TextBox x:Name="Log" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="#53657F" Padding="0"/></DockPanel>
  </Border>
 </Grid></Border>
</Window>
