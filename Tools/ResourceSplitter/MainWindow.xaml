<Window x:Class="MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Resource Splitter" Icon="Assets/AppIcon.ico"
        Width="1000" Height="790" MinWidth="870" MinHeight="730" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" FontFamily="Malgun Gothic" FontSize="13" Foreground="#182238"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,11"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#182238"/>
            <Setter Property="BorderBrush" Value="#DCE2EC"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#3177F3"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Card" Background="White" BorderBrush="#DCE2EC" BorderThickness="1" CornerRadius="12" Padding="20">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="Background" Value="#EDF3FF"/><Setter TargetName="Card" Property="BorderBrush" Value="#3177F3"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#3177F3"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#F4F6FA">
        <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#14223A">
            <Grid Margin="24,32">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="Assets/AppIcon.png" Width="64" Height="64" HorizontalAlignment="Left"/>
                    <TextBlock Text="RESOURCE" FontFamily="Segoe UI" FontWeight="Bold" FontSize="17" Foreground="White" Margin="0,20,0,0"/>
                    <TextBlock Text="SPLITTER" FontFamily="Segoe UI" FontWeight="Bold" FontSize="17" Foreground="White"/>
                    <TextBlock Text="파일은 가볍게.&#x0a;작업은 그대로." Foreground="#A5B5CE" Margin="0,16,0,34" LineHeight="23"/>
                    <Border Background="#263B59" CornerRadius="8" Padding="14,12"><TextBlock Text="리소스 관리" Foreground="#E7EFFF" FontWeight="Bold"/></Border>
                    <TextBlock Text="분할 · 복원 · Git 자동화" Foreground="#91A3BD" FontSize="11" Margin="14,12,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border BorderBrush="#33455F" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="50 MiB 초과 파일" Foreground="#E0E8F5" FontWeight="Bold"/>
                            <TextBlock Text="49 MiB 단위로 분할" Foreground="#91A3BD" FontSize="11" Margin="0,6,0,0"/>
                            <TextBlock Text="SHA-256 무결성 검증" Foreground="#91A3BD" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="WINDOWS  /  LOCAL FIRST" Foreground="#6F85A4" FontFamily="Segoe UI" FontSize="9" Margin="0,24,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="리소스 관리" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="큰 파일을 나누고, 필요할 때 원본으로 되돌리세요." Foreground="#718096" Margin="0,8,0,24"/>
            </StackPanel>
            <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E2E7EF" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="프로젝트 폴더" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPath" Padding="12,10" BorderBrush="#DCE2EC" Background="#F8FAFD" VerticalContentAlignment="Center" ToolTip="프로젝트 경로를 입력하거나 폴더를 끌어다 놓으세요."/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="폴더 선택" Margin="10,0,0,0" Click="Browse"/>
                    </Grid>
                    <TextBlock Text="폴더를 이 창에 끌어다 놓아도 됩니다." Foreground="#8A96A8" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,22,0,0">
                <TextBlock Text="작업 선택" FontWeight="Bold" Margin="0,0,0,12"/>
                <UniformGrid Columns="3" x:Name="Modes">
                    <RadioButton x:Name="SplitMode" GroupName="Mode" Style="{StaticResource ModeCard}" Margin="0,0,10,0" Tag="split" Checked="ModeChanged">
                        <StackPanel><TextBlock Text="01  SPLIT" Foreground="#3177F3" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="파일 분할" FontSize="18" FontWeight="Bold" Margin="0,12,0,10"/>
                            <TextBlock Text="원본을 작은 복원 정보와&#x0a;조각으로 나눕니다." Foreground="#718096" FontSize="11" LineHeight="19"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="JoinMode" GroupName="Mode" Style="{StaticResource ModeCard}" Margin="0,0,10,0" Tag="join" Checked="ModeChanged">
                        <StackPanel><TextBlock Text="02  RESTORE" Foreground="#24907C" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="원본 복원" FontSize="18" FontWeight="Bold" Margin="0,12,0,10"/>
                            <TextBlock Text="조각을 검증하고&#x0a;실제 원본으로 되돌립니다." Foreground="#718096" FontSize="11" LineHeight="19"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="GitMode" GroupName="Mode" Style="{StaticResource ModeCard}" Tag="git-install" Checked="ModeChanged">
                        <StackPanel><TextBlock Text="03  AUTOMATE" Foreground="#8160C2" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                                <TextBlock Text="Git 자동화" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="#E9DEFA" CornerRadius="4" Padding="5,3" Margin="8,0,0,0"><TextBlock Text="권장" Foreground="#7652B2" FontSize="10" FontWeight="Bold"/></Border>
                            </StackPanel>
                            <TextBlock Text="Git에 넣고 받을 때&#x0a;자동 변환하도록 설정합니다." Foreground="#718096" FontSize="11" LineHeight="19"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
                <Border Background="#EAF0F7" CornerRadius="8" Padding="14,11" Margin="0,12,0,0">
                    <TextBlock x:Name="ModeHint" TextWrapping="Wrap" Foreground="#5B6C83" FontSize="11" LineHeight="18"/>
                </Border>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,20,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="준비됨" FontWeight="Bold"/>
                    <ProgressBar x:Name="Progress" Height="3" Width="150" HorizontalAlignment="Left" Foreground="#3177F3" Background="#E2E7EF" Visibility="Collapsed" Margin="0,9,0,0"/>
                </StackPanel>
                <Button x:Name="RunButton" Grid.Column="1" Content="분할 시작  →" Padding="25,13" Background="#3177F3" Foreground="White" BorderBrush="#3177F3" FontWeight="Bold" Click="Execute"/>
            </Grid>
            <Border Grid.Row="4" Background="White" CornerRadius="12" BorderBrush="#E2E7EF" BorderThickness="1" Padding="18,14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="로그 복사" Padding="10,5" FontSize="10" Click="CopyLog"/>
                        <TextBlock Text="작업 기록" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Foreground="#627188" FontSize="11" FontFamily="Consolas, Malgun Gothic" Padding="0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
