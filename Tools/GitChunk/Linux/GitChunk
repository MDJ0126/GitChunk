#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import tkinter' >/dev/null 2>&1; then
    echo 'Git Chunk desktop requires Python 3 and Tk. Ubuntu/Debian: sudo apt install python3-tk' >&2
    echo "The command line is available at: $base/git-chunk" >&2
    exit 1
fi
exec python3 "$base/LinuxApp.py" "$@"
